{
  "name": "sidediff",
  "version": "0.2.0",
  "description": "GitHub-style diff review in the browser, with a live notes column for humans and agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sidediff": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@effect/atom-react": "4.0.0-rc.117",
    "@effect/platform-browser": "4.0.0-rc.117",
    "@pierre/diffs": "^1.4.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
