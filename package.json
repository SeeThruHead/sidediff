{
  "name": "sidediff",
  "version": "0.6.1",
  "description": "GitHub-style diff review in the browser, with a live notes column for humans and agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sidediff": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@effect/language-service": "0.87.4",
    "@effect/platform-node": "4.0.0-rc.118",
    "@effect/platform-node-shared": "4.0.0-rc.118",
    "effect": "4.0.0-rc.118",
    "typescript-language-server": "5.1.3",
    "vscode-langservers-extracted": "4.10.0"
  },
  "devDependencies": {
    "@effect/atom-react": "4.0.0-rc.118",
    "@effect/platform-browser": "4.0.0-rc.118",
    "@pierre/diffs": "^1.4.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "effect": "4.0.0-rc.118",
    "@effect/platform-node": "4.0.0-rc.118",
    "@effect/platform-node-shared": "4.0.0-rc.118"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  }
}
